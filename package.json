{
  "name": "sanity-studio-search-with-filters",
  "version": "0.1.0",
  "description": "Reusable search input + filter UI for Sanity Studio plugins. Search box, document-type popover, custom filter chips, pinned filters (date / references), and per-operator filter inputs — all driven by props.",
  "keywords": [
    "sanity",
    "sanity-studio",
    "studio",
    "search",
    "filter",
    "filters"
  ],
  "license": "MIT",
  "author": "Adam Harris",
  "homepage": "https://github.com/spindle79/sanity-studio-search-with-filters",
  "repository": {
    "type": "git",
    "url": "https://github.com/spindle79/sanity-studio-search-with-filters.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "react-focus-lock": "^2.13.0"
  },
  "peerDependencies": {
    "@sanity/icons": "^3",
    "@sanity/ui": "^2",
    "react": "^18 || ^19",
    "styled-components": "^5 || ^6"
  },
  "devDependencies": {
    "@sanity/icons": "^3",
    "@sanity/ui": "^2",
    "@types/react": "^19",
    "react": "^19",
    "styled-components": "^6",
    "tsup": "^8",
    "typescript": "^5.7"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
